GROQ_API_KEY=replace_with_your_key
GROQ_MODEL=openai/gpt-oss-20b
# Set in production to the cloud API ending in /api. Local Vite uses its proxy.
# VITE_API_BASE_URL=https://your-cloud-api.example.com/api
# Optional in production for the local-only Windows service (run on the user's PC).
# VITE_LOCAL_API_BASE_URL=http://127.0.0.1:8765/api
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=nexora
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
PUBLIC_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local API only; optionally allow a deployed HTTPS frontend to talk to the
# Windows service on the user's own PC (the service still binds to loopback).
LOCAL_FRONTEND_ORIGINS=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional Windows recording-device index when the default microphone is wrong.
# Use `python -c "import speech_recognition as sr; print(sr.Microphone.list_microphone_names())"`.
MICROPHONE_DEVICE_INDEX=
