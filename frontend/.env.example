# Local public/cloud API (MongoDB + Groq, no Windows automation)
VITE_CLOUD_API_PROXY_TARGET=http://127.0.0.1:8002

# Local Windows-only microphone, TTS, and computer control
VITE_LOCAL_API_PROXY_TARGET=http://127.0.0.1:8765

# Production build settings (configure these in Vercel). Local dev always uses the Vite proxy.
# VITE_API_BASE_URL=https://your-render-service.example.com/api
# VITE_LOCAL_API_BASE_URL=http://127.0.0.1:8765/api
# Set to true only when the browser should connect to the Windows assistant on localhost.
# VITE_ENABLE_LOCAL_API=false
